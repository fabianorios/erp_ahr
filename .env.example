VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cora Integração Direta. Sem segredo neste arquivo.
# No servidor, certificate.pem e private-key.key ficam em /var/www/erpahr/secrets/cora/ com modo 600.
# CORA_BOLETO_DIR vazio usa /var/www/erpahr/secrets/cora/boletos
# NFSE_PDF_DIR vazio usa /var/www/erpahr/secrets/nfse. O arquivo é <tituloId>.pdf.
# NFS-e no Emissor Nacional. No servidor o A1 é /var/www/gestaoconsultoria/secrets/esocial.pfx.
# A senha é ESOCIAL_CERT_PASSWORD em secrets/esocial.env. NFSE_CERT_PATH só vale sem essa pasta.
# NFSE_AMBIENTE: producao ou homologacao. Rode sql/nfse-nacional.sql antes do primeiro Gerar NF.
CORA_CLIENT_ID=
CORA_CERT_PATH=
CORA_KEY_PATH=
CORA_API_BASE=https://matls-clients.api.cora.com.br
CORA_BOLETO_DIR=
NFSE_PDF_DIR=
NFSE_AMBIENTE=
NFSE_CNPJ=
# cTribNac: quatro dígitos recebem 01 no fim. cTribMun só entra com 3 dígitos. Sem inscrição municipal.
NFSE_ITEM_SERVICO=
NFSE_CODIGO_TRIBUTACAO=
NFSE_CODIGO_NBS=
NFSE_ALIQUOTA_ISS=
NFSE_SERIE_DPS=
NFSE_CODIGO_MUNICIPIO=
NFSE_CERT_PATH=
NFSE_CERT_PASSWORD=
