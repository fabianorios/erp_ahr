# Cora Integração Direta. Sem segredo neste arquivo.
# No servidor, certificate.pem e private-key.key ficam em /var/www/erpahr/secrets/cora/ com modo 600.
# CORA_BOLETO_DIR vazio usa /var/www/erpahr/secrets/cora/boletos
# NFSE_PDF_DIR vazio usa /var/www/erpahr/secrets/nfse. O arquivo é <tituloId>.pdf.
# NFS-e no Emissor Nacional. Certificado A1 em PEM. Sem segredo neste arquivo.
# NFSE_API_BASE vazio usa https://sefin.nfse.gov.br/SefinNacional
# Rode sql/nfse-nacional.sql antes do primeiro Gerar NF.
CORA_CLIENT_ID=
CORA_CERT_PATH=
CORA_KEY_PATH=
CORA_API_BASE=https://matls-clients.api.cora.com.br
CORA_BOLETO_DIR=
NFSE_PDF_DIR=
NFSE_API_BASE=https://sefin.nfse.gov.br/SefinNacional
NFSE_CNPJ=
NFSE_IM=
NFSE_CODIGO_SERVICO=
NFSE_SERIE=1
NFSE_CERT_PATH=
NFSE_KEY_PATH=
